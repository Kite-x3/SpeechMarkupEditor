<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:SpeechMarkupEditor.Assets"
             x:Class="SpeechMarkupEditor.Controls.TimeEditorControl">
    <DataValidationErrors>
        <Grid ColumnDefinitions="*,Auto"
              ColumnSpacing="6">
                <MaskedTextBox Grid.Column="0" x:Name="TimeTextBox"
                               Mask="{x:Static res:Resources.TimeStampMask}"
                               PromptChar="0"
                               GotFocus="OnTimeTextBoxGotFocus"
                               LostFocus="OnTimeTextBoxLostFocus"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal"
                        Spacing="2"
                        Margin="0">
                <Button Content="+"
                        Width="28"
                        Height="28"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Click="OnIncrement"/>
                <Button Content="-"
                        Width="28"
                        Height="28"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Click="OnDecrement"/>
            </StackPanel>
        </Grid>
    </DataValidationErrors>
</UserControl>
