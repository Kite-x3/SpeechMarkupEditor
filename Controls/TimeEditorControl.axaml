<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SpeechMarkupEditor.Controls.TimeEditorControl">
    <DataValidationErrors>
        <StackPanel Orientation="Horizontal"
                    Spacing="6">
                <MaskedTextBox x:Name="TimeTextBox"
                               Mask="00:00/000"
                               PromptChar="0"
                               TextChanged="OnTimeTextChanged"
                               GotFocus="OnTimeTextBoxGotFocus"
                               LostFocus="OnTimeTextBoxLostFocus"/>

            <StackPanel Orientation="Horizontal"
                        Spacing="2"
                        Margin="0">
                <Button Content="+"
                        Width="28"
                        Height="28"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Click="OnIncrement"/>
                <Button Content="-"
                        Width="28"
                        Height="28"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Click="OnDecrement"/>
            </StackPanel>
        </StackPanel>
    </DataValidationErrors>
</UserControl>
